<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WeatherCast</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(180deg, #f7f8fb 0%, #eef2f7 100%);
            font-family: 'Inter', sans-serif;
            color: #4b5563;
        }
        .card {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 2rem;
            box-shadow: 0 10px 35px rgba(148, 163, 184, 0.12);
            border: 1px solid rgba(226, 232, 240, 0.9);
            backdrop-filter: blur(10px);
        }
        .btn-green { background-color: #bbf7d0; color: #166534; }
        .bg-pastel-blue   { background-color: #dbeafe; }
        .bg-pastel-grey   { background-color: #f3f4f6; }
        .bg-pastel-red    { background-color: #fee2e2; }
        .bg-pastel-yellow { background-color: #fef3c7; }
        .pill-search {
            background: #edf1f5;
            border-radius: 999px;
            border: 1px solid #e5e7eb;
        }
        .metric-chip {
            border-radius: 1.5rem;
            padding: 1rem;
            border: 1px solid rgba(226,232,240,.9);
        }
        .hour-card, .day-row, .source-row, .alert-card {
            border: 1px solid rgba(226,232,240,.9);
        }
    </style>
</head>
<body class="p-4 lg:p-8">
    @RenderBody()
</body>
</html>
